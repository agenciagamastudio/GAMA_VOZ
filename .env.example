# ============================================
# GAMA Voz — Configuração de Certificados SSL
# ============================================
# Cada usuário deve colocar suas próprias chaves SSL
# nas pastas indicadas abaixo.
#
# Estrutura esperada:
#   frontend/certs/
#   │
#   ├── cert.pem    → Certificado SSL (public)
#   └── key.pem     → Chave privada SSL (PRIVATE — NÃO COMPARTILHAR)
#
# Alternativamente (para dev local sem SSL):
#   frontend/ssl/
#   │
#   ├── cert.pem    → Certificado SSL alternativo
#   └── key.pem     → Chave privada SSL alternativa
# ============================================

# Caminho do certificado (opcional — se não informado, usa frontend/certs/)
# SSL_CERT_PATH=frontend/certs/cert.pem

# Caminho da chave privada (opcional — se não informado, usa frontend/certs/)
# SSL_KEY_PATH=frontend/certs/key.pem

# =====================================================
# Configurações gerais do backend
# =====================================================
FLASK_ENV=development
API_PORT=5001

